---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const posts = await getCollection("esai")
---

<Layout crumbs={[{ label: "Esai", href: "/esai" }]}>
  <MetaPage slot="head" title="Esai" description="Kumpulan esai." />
  <ul>
    {posts.map((post) => <BlogCard post={post} basePath="/esai" />)}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
