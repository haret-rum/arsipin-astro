---
import BlogCard from "@/components/BlogCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getCollection } from "astro:content"

const posts = await getCollection("redaksi")
---

<Layout crumbs={[{ label: "Redaksi", href: "/redaksi" }]}>
  <MetaPage slot="head" title="Redaksi" description="Kumpulan redaksi." />
  <ul>
    {posts.map((post) => <BlogCard post={post} basePath="/redaksi" />)}
  </ul>
</Layout>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
  }
</style>
